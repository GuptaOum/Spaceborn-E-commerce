# Shared with the API (COPILOT_TOKEN in services/api/.env), at least 24 characters.
COPILOT_TOKEN=
# Where the catalog tools call the Node API.
CATALOG_API_URL=http://localhost:4000
AWS_REGION=ap-south-1
# Any Bedrock model or inference profile that supports Converse with tool use.
BEDROCK_CHAT_MODEL=global.amazon.nova-2-lite-v1:0
