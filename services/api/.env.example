NODE_ENV=development
PORT=4000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=spaceborn
DB_USER=spaceborn
DB_PASSWORD=spaceborn
DB_SSL=disable

FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
# Full service-account JSON on one line. Needed for session cookies and approving vendors.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Leave empty to use mock payments in development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Development only: accept "Authorization: Dev <uid>:<role>" instead of a Firebase token.
AUTH_DEV_BYPASS=false

# Transactional email. "log" prints mails to the log; "ses" sends through Amazon SES from MAIL_FROM.
MAIL_PROVIDER=log
MAIL_FROM=
MAIL_CONFIGURATION_SET=
# Used for links in emails.
PUBLIC_ORIGIN=http://localhost:3000
VENDOR_ORIGIN=http://localhost:3001

# Local dev stores uploaded design files on disk; production uses a private S3 bucket.
UPLOAD_DIR=.uploads
MAX_UPLOAD_MB=50
UPLOADS_BUCKET=
