# ==============================================================================
# Spaceborn E-Commerce & Fabrication Platform — Render Environment Configuration
# Reference template for Zero-Dollar ($0) Cloud Deployment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=production
# In Render, PORT is dynamically injected by the platform (e.g., 10000).
PORT=4000

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL (Free Tier)
# ------------------------------------------------------------------------------
# You can provide either the full DATABASE_URL or individual DB_* variables.
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DB]?sslmode=require
#
# Supabase Pooled Connection (Supavisor / PgBouncer - Recommended for Render):
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?sslmode=require

# Alternatively, configure connection parameters individually:
# DB_HOST=db.[PROJECT-REF].supabase.co
# DB_PORT=6543
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your_secure_supabase_db_password
DB_SSL=require
DB_POOL_MAX=10

# ------------------------------------------------------------------------------
# 3. FIREBASE AUTHENTICATION (Free Spark Plan)
# ------------------------------------------------------------------------------
# Project ID from Firebase Console -> Project Settings -> General
FIREBASE_PROJECT_ID=spaceborn-demo-xxxx

# Firebase Admin SDK Service Account JSON (single line string).
# Generate at: Firebase Console -> Project Settings -> Service Accounts -> "Generate new private key".
# Paste the entire JSON file as a single line:
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"spaceborn-demo-xxxx","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-...@spaceborn-demo-xxxx.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Client-side Firebase Web SDK Keys (Next.js public vars):
# Found in: Firebase Console -> Project Settings -> General -> "Your apps" (Web app </>):
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyA...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=spaceborn-demo-xxxx.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=spaceborn-demo-xxxx
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# ------------------------------------------------------------------------------
# 4. ZERO-DOLLAR COST OPERATIONAL OVERRIDES
# ------------------------------------------------------------------------------
# Run mock payment checkout without requiring Razorpay production API credentials
PAYMENTS_ALLOW_MOCK=true

# Store uploaded CAD design files (.stl, .step, .dxf) on disk (.uploads)
# without requiring AWS S3 KMS buckets
UPLOADS_ALLOW_LOCAL=true

# Enable CORS for cross-service calls (set to * or specific onrender.com URLs)
CORS_ORIGIN=*

# Show demo switcher floating bar on unified gateway mode (true / false)
SHOW_DEMO_BANNER=true

# ------------------------------------------------------------------------------
# 5. SERVICE NETWORKING & ROUTING
# ------------------------------------------------------------------------------
# In 4-Service mode, Next.js apps route /v1 to your deployed API:
# NEXT_PUBLIC_API_URL=https://spaceborn-api.onrender.com
# API_ORIGIN=https://spaceborn-api.onrender.com

# In Unified mode, the gateway internal proxy defaults to http://127.0.0.1:4000:
API_ORIGIN=http://127.0.0.1:4000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000

# ------------------------------------------------------------------------------
# 6. PLATFORM ADMINISTRATION
# ------------------------------------------------------------------------------
# Comma-separated list of pre-authorized root administrator emails:
ADMIN_EMAILS=admin@spaceborn.com
NEXT_PUBLIC_ADMIN_EMAILS=admin@spaceborn.com

